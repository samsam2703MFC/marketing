# L'application est servie depuis un sous-répertoire (/marketing) et non depuis
# la racine du domaine. Sans ces règles, deux choses cassent : les appels API
# n'atteignent jamais le contrôleur frontal PHP, et un rechargement de page
# renvoie 404 puisque le routage est côté client.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Les appels /api/... partent vers le contrôleur frontal du module.
  # REQUEST_URI n'est pas modifié par la réécriture : PHP voit toujours le
  # chemin d'origine et en retire lui-même le préfixe d'installation.
  RewriteRule ^api/(.*)$ api/public/index.php [L,QSA]

  # Fichier ou répertoire réel : servi tel quel.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Sinon l'application, qui gère son propre routage.
  RewriteRule ^ index.html [L]
</IfModule>

# Mise en cache. Sans ces règles, Apache ne dit rien et le navigateur décide
# seul : il garde `index.html` un moment, or c'est lui qui nomme les fichiers
# d'actifs — dont l'empreinte change à chaque publication. Un déploiement passe,
# le serveur sert la nouvelle version, et l'écran ne bouge pas parce que la page
# gardée en cache continue de réclamer les anciens actifs.
<IfModule mod_headers.c>
  # La page se revalide à chaque visite. Elle pèse deux kilo-octets : la
  # vérifier coûte moins qu'une version en retard d'un déploiement.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Les scripts et styles portent leur empreinte dans leur nom : leur contenu ne
  # changera jamais, ils se gardent donc un an. Les images n'en portent pas —
  # elles restent sous le régime par défaut, faute de quoi un logo remplacé
  # mettrait un an à apparaître.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Le fichier de configuration ne vit pas ici, mais si une installation le pose
# malgré tout à la racine du déploiement, il ne doit pas être téléchargeable.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
