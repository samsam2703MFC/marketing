# Le module est déployé sous la racine web. Seul le contrôleur frontal doit être
# atteignable : ni les sources PHP, ni les fichiers de configuration.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md|json|lock)$">
  Require all denied
</FilesMatch>

# Tout le PHP sauf index.php (le contrôleur frontal, sous public/).
<FilesMatch "^(?!index\.php$).*\.php$">
  Require all denied
</FilesMatch>
