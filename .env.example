# =============================================================================
# Modèle de configuration. Copier en `.env` — jamais versionné.
#
# Ce fichier sert deux consommateurs distincts :
#   • les variables VITE_* sont lues au BUILD du front (poste de dev ou CI) ;
#   • les variables MAR_DB_* sont lues à l'EXÉCUTION sur le SERVEUR, par l'API
#     et par db/migrate.php.
#
# Sur le serveur, ce fichier vit à la racine du déploiement, donc au-dessus de
# la racine web (api/public) : il n'est pas servi. S'il devait se retrouver dans
# un répertoire exposé, interdisez-le explicitement dans le vhost.
# =============================================================================

# --- Serveur : base de données -----------------------------------------------
# Nécessaires pour créer les tables comme pour lire et écrire dedans.
# Ils ne transitent jamais par GitHub : migrate.php s'exécute sur le serveur.
# MAR_DB_HOST=127.0.0.1
# MAR_DB_PORT=3306
# Base partagée avec l'ERP : les tables du module y sont préfixées mar_.
# MAR_DB_NAME=atelier_db
# MAR_DB_USER=
# MAR_DB_PASSWORD=
# Alternative au couple hôte/port si MySQL écoute sur un socket Unix :
# MAR_DB_SOCKET=/var/run/mysqld/mysqld.sock

# --- Serveur : API de l'ERP --------------------------------------------------
# Tarif d'une boutique, pour l'étape « Prix » de l'assistant :
#   GET {base}/api/v1/shops/{shop}/products/price-list/document
# `{shop}` est l'identifiant ERP de la boutique (mar_shop.erp_shop_id).
#
# Sans MAR_ERP_API_BASE, aucun appel n'est tenté et les prix viennent du
# catalogue réseau (mar_offer_item.price_amount, repris de
# product.suggested_sale_price). L'étape fonctionne dans les deux cas ; l'écran
# dit laquelle des deux sources a servi.
# MAR_ERP_API_BASE=http://127.0.0.1
# MAR_ERP_API_TOKEN=
# MAR_ERP_API_TIMEOUT=5
# Si le chemin diffère sur cette installation :
# MAR_ERP_PRICE_LIST_PATH=/api/v1/shops/{shop}/products/price-list/document

# --- Serveur : tables de l'ERP lues par le module ----------------------------
# Le module ne crée aucune de ces tables et n'y écrit jamais : il les lit. Ces
# variables servent à le pointer sur les bonnes, sans quoi il faudrait en
# fabriquer une copie — ce qui donnerait un second chiffre pour le même fait.
#
# Chaque valeur s'écrit « table » ou « schéma.table ». Sans schéma, c'est la base
# du module (MAR_DB_NAME) qui est visée : cela ne convient que si le module vit
# dans la même base que l'ERP. Ici les tables de l'ERP sont dans `atelierby_db`,
# donc on qualifie — et le compte MySQL du module doit y avoir le SELECT.
#
# Magasins. `mar_shop.erp_shop_id` recopie l'identifiant de cette table, et c'est
# par lui que les factures de redevance retrouvent leur boutique : comme elles
# désignent `shops.id`, c'est `shops` qu'il faut déclarer, et non le défaut
# `franchisee_shop`. Changer cette valeur demande de relancer la reprise ERP, le
# temps que `erp_shop_id` soit réécrit.
# MAR_ERP_SHOPS_TABLE=atelierby_db.shops
#
# Les factures de redevance ne sont plus lues en base : elles viennent de l'API
# (`GET /api/v1/admin/royalties/invoices?period=AAAA-MM`), dont le paramètre
# `period` désigne la période couverte. Sans MAR_ERP_API_BASE ci-dessus, l'écran
# le dit et n'écrit rien. Le chemin ne se déclare que s'il diffère :
# MAR_ERP_ROYALTY_INVOICES_PATH=/api/v1/admin/royalties/invoices
#
# Les autres tables lues par la reprise ERP, à qualifier de la même façon si le
# module ne partage pas la base de l'ERP :
# MAR_ERP_PRODUCTS_TABLE=atelierby_db.product
# MAR_ERP_PRODUCT_CATEGORIES_TABLE=atelierby_db.product_category
# MAR_ERP_SEASONS_TABLE=atelierby_db.product_availability_period
# MAR_ERP_CUSTOMERS_TABLE=atelierby_db.client
# MAR_ERP_SECTORS_TABLE=atelierby_db.b2b_client_type
# MAR_ERP_SECTOR_LINK_TABLE=atelierby_db.b2b_client_interest_connection
# MAR_ERP_TRANSACTIONS_TABLE=atelierby_db.transaction
# MAR_ERP_TRANSACTION_LINES_TABLE=atelierby_db.transaction_product

# --- Build du front : chemins ------------------------------------------------
# À renseigner si l'application n'est pas servie à la racine du domaine.
# Vides, le build vise `/`.
# VITE_BASE=/marketing/
# VITE_API_BASE=/marketing

# --- Build du front : ERP TFBuddy --------------------------------------------
# Racine de l'API ERP. Vide en développement : les appels passent par le proxy
# Vite `/erp`, relayé vers https://test.tfbuddy.com (seul serveur du swagger).
# VITE_TFBUDDY_BASE_URL=https://test.tfbuddy.com

# Réalm d'authentification admin :
#   phone  → POST /api/v1/admin/auth/login   ({ phone, password }, normalisé E.164)   [défaut]
#   legacy → POST /api/v1/admin/authenticate ({ login, password })
# VITE_TFBUDDY_AUTH_MODE=phone
